  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background: #f4f6fa;
}

QWidget#centralwidget {
    background: #f4f6fa;
}

QLabel#titleLabel {
    color: #172033;
    font-size: 22px;
    font-weight: 700;
}

QLabel#subtitleLabel {
    color: #667085;
    font-size: 12px;
}

QFrame#workflowBar,
QFrame#preprocessingPanel {
    background: #ffffff;
    border: 1px solid #d7dfeb;
    border-radius: 8px;
}

QLabel#originalImageLabel,
QLabel#processedImageLabel {
    background: #111827;
    color: #cbd5e1;
    font-size: 15px;
}

QFrame#enhancementSection,
QFrame#smoothingSection,
QFrame#geometrySection {
    background: #f8fafc;
    border: 1px solid #e3e8f0;
    border-radius: 7px;
}

QLabel#preprocessingTitle {
    color: #1f2937;
    font-size: 15px;
    font-weight: 700;
}

QLabel#preprocessingSubtitle {
    color: #667085;
    font-size: 12px;
}

QLabel#enhancementTitle,
QLabel#smoothingTitle,
QLabel#geometryTitle {
    color: #1f2937;
    font-size: 13px;
    font-weight: 700;
}

QLabel#enhancementHint,
QLabel#smoothingHint,
QLabel#geometryHint,
QLabel#blurLabel,
QLabel#resizeLabel,
QLabel#cropMarginLabel {
    color: #64748b;
    font-size: 12px;
}

QCheckBox {
    color: #334155;
    spacing: 9px;
    min-height: 24px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #b8c4d4;
    border-radius: 4px;
    background: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #3b82f6;
    background: #eff6ff;
}

QCheckBox::indicator:checked {
    border-color: #2563eb;
    background: #2563eb;
}

QCheckBox::indicator:checked:hover {
    border-color: #1d4ed8;
    background: #1d4ed8;
}

QFrame#enhancementSection QCheckBox {
    background: #ffffff;
    border: 1px solid #dce4ef;
    border-radius: 6px;
    color: #263244;
    font-weight: 600;
    padding: 8px 10px;
}

QFrame#enhancementSection QCheckBox:hover {
    background: #f8fbff;
    border-color: #bfdbfe;
}

QFrame#enhancementSection QCheckBox:checked {
    background: #eff6ff;
    border-color: #bfdbfe;
    color: #1d4ed8;
}

QCheckBox:disabled {
    color: #94a3b8;
}

QPushButton {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    color: #243041;
    font-weight: 600;
    padding: 6px 12px;
}

QPushButton:hover {
    background: #f8fafc;
    border-color: #94a3b8;
}

QPushButton:pressed {
    background: #eef2f7;
}

QPushButton#openImageButton {
    background: #2563eb;
    border-color: #1d4ed8;
    color: #ffffff;
}

QPushButton#openImageButton:hover {
    background: #1d4ed8;
}

QSlider::groove:horizontal {
    background: #dbe3ef;
    border-radius: 3px;
    height: 6px;
}

QSlider {
    min-height: 28px;
    max-height: 28px;
}

QSlider::sub-page:horizontal {
    background: #3b82f6;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 2px solid #2563eb;
    border-radius: 8px;
    margin: -5px 0;
    width: 16px;
}

QSpinBox {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    color: #243041;
    padding: 4px 8px;
}</string>
